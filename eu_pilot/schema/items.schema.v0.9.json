{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "k-veriai/items.schema.v0.9.json",
 "title": "K-VeriAI item (one line of items_<lang>_<release>.jsonl), draft v0.9",
 "$comment": "Copied from the agreed Drive folder (v0.9.3 / schema). Draft v0.9 for review. Same structure as v0.8. Stage 1 = 4-option single-choice. Only input is sent to the model; metadata is removed at run time. Required keys are always present; values that do not apply are null or []. v0.9 rule for translations: the English item has its own item_id, and its display_code reuses the number of the Korean source item.",
 "type": "object",
 "required": ["schema_version", "item_id", "item_version", "input", "metadata"],
 "additionalProperties": false,
 "properties": {
  "schema_version": {"type": "string"},
  "item_id": {"type": "string", "pattern": "^KVA-[0-9]{6,}$"},
  "item_version": {"type": "integer", "minimum": 1},
  "input": {
   "type": "object",
   "required": ["context", "question", "assumptions", "response_instruction"],
   "additionalProperties": false,
   "properties": {
    "context": {"type": "string"},
    "question": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "response_instruction": {"type": "string", "minLength": 1},
    "options": {
     "type": "array",
     "minItems": 4,
     "maxItems": 4,
     "items": {
      "type": "object",
      "required": ["option_id", "label", "text", "display_order"],
      "additionalProperties": false,
      "properties": {
       "option_id": {"type": "string", "minLength": 1},
       "label": {"enum": ["A", "B", "C", "D"]},
       "text": {"type": "string", "minLength": 1},
       "display_order": {"type": "integer", "minimum": 1}
      }
     }
    }
   }
  },
  "metadata": {
   "type": "object",
   "additionalProperties": false,
   "required": ["domain", "display_code", "legacy_item_code", "primary_risk", "secondary_risks", "risk_subtype", "target_risk", "stage", "response_format", "base_item_ref", "explanation_required", "request_class", "language", "locale_scope", "jurisdiction", "reference_date", "reference_date_reason", "objective", "criterion_spec_ref", "source_refs", "content_origin", "review_status", "author_id", "created_at", "updated_at", "change_reason", "sharing_scope"],
   "properties": {
    "domain": {"enum": ["medical", "finance", "legal", "public_admin", "education"]},
    "display_code": {"type": "string", "pattern": "^(MED|FIN|LAW|PUB|EDU)-R[1-7]-[0-9]{6,}-(KO|EN)$"},
    "legacy_item_code": {"type": ["string", "null"]},
    "primary_risk": {"$ref": "#/$defs/risk"},
    "secondary_risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}, "uniqueItems": true},
    "risk_subtype": {"type": "string", "pattern": "^R[1-7]\\.[a-z_]+$"},
    "target_risk": {"oneOf": [{"$ref": "#/$defs/risk"}, {"type": "null"}]},
    "stage": {"enum": [1, 2, 3]},
    "response_format": {"enum": ["single_choice", "free_text"]},
    "base_item_ref": {"oneOf": [{"$ref": "#/$defs/item_ref"}, {"type": "null"}]},
    "explanation_required": {"type": "boolean"},
    "request_class": {"enum": ["benign", "risky", "attack"]},
    "language": {"enum": ["ko", "en"]},
    "locale_scope": {"enum": ["common", "jurisdiction_specific"]},
    "jurisdiction": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(GLOBAL|[A-Z]{2})$"}},
    "reference_date": {"type": ["string", "null"], "format": "date"},
    "reference_date_reason": {"type": ["string", "null"]},
    "objective": {"type": "string", "minLength": 1},
    "criterion_spec_ref": {
     "type": "object",
     "required": ["criterion_spec_id", "spec_version"],
     "additionalProperties": false,
     "properties": {
      "criterion_spec_id": {"type": "string"},
      "spec_version": {"type": "integer", "minimum": 1}
     }
    },
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "content_origin": {"enum": ["human", "ai_assisted", "adapted", "synthetic"]},
    "review_status": {"enum": ["draft", "content_checked", "approved", "held", "retired"]},
    "author_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "change_reason": {"type": ["string", "null"]},
    "sharing_scope": {"enum": ["internal", "partner", "public"]},
    "extensions": {"type": "object"}
   },
   "allOf": [
    {
     "if": {"properties": {"primary_risk": {"const": "R6"}}},
     "then": {"properties": {"target_risk": {"enum": ["R1", "R2", "R3", "R4", "R5", "R7"]}}},
     "else": {"properties": {"target_risk": {"type": "null"}}}
    },
    {
     "if": {"properties": {"reference_date": {"type": "null"}}},
     "then": {"properties": {"reference_date_reason": {"type": "string", "minLength": 1}}}
    },
    {
     "if": {"properties": {"stage": {"const": 1}}},
     "then": {"properties": {"response_format": {"const": "single_choice"}, "explanation_required": {"const": false}}}
    }
   ]
  }
 },
 "allOf": [
  {
   "if": {"properties": {"metadata": {"properties": {"response_format": {"const": "single_choice"}}}}},
   "then": {"properties": {"input": {"required": ["options"]}}}
  }
 ],
 "$defs": {
  "risk": {"enum": ["R1", "R2", "R3", "R4", "R5", "R6", "R7"]},
  "item_ref": {
   "type": "object",
   "required": ["item_id", "item_version"],
   "additionalProperties": false,
   "properties": {
    "item_id": {"type": "string", "pattern": "^KVA-[0-9]{6,}$"},
    "item_version": {"type": "integer", "minimum": 1}
   }
  }
 }
}
